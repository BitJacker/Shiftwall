<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Shiftwall.Features</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shiftwall.Core\Shiftwall.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DiffPlex" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\schemas\*.json" LogicalName="Shiftwall.Schemas.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\data\rules\*.json" LogicalName="Shiftwall.Rules.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Shiftwall.Features.Tests" />
  </ItemGroup>
</Project>
