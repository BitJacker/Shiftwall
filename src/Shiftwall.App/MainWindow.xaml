<Window x:Class="Shiftwall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Shiftwall.App.Localization"
        xmlns:loc="clr-namespace:Shiftwall.Presentation.Localization;assembly=Shiftwall.Presentation"
        Title="Shiftwall" Icon="Assets/icon.ico"
        Width="1280" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Side menu -->
        <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,18,18,14">
                    <Image Source="Assets/logo-64.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Shiftwall" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{l:T App.Tagline}" FontSize="11" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14">
                    <TextBlock Text="{l:T Settings.Theme}" FontSize="12" Style="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Margin="0,4,0,10"
                              AutomationProperties.Name="{l:T Settings.Theme}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ThemeToText}">
                                            <Binding />
                                            <Binding Source="{x:Static loc:Loc.Instance}" Path="Culture" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Command="{Binding ToggleLanguageCommand}" HorizontalAlignment="Stretch" Content="{l:T Settings.SwitchLanguage}" />
                    <TextBlock Text="{l:T App.Offline}" FontSize="11" Margin="0,12,0,0" Style="{StaticResource Muted}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="6,0"
                         AutomationProperties.Name="{l:T Nav.Menu}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocKey}">
                                            <Binding Path="TitleKey" />
                                            <Binding Source="{x:Static loc:Loc.Instance}" Path="Culture" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" Margin="28,22,28,18" Focusable="False" />
    </Grid>
</Window>
