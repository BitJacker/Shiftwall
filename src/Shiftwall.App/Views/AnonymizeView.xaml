<UserControl x:Class="Shiftwall.App.Views.AnonymizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Shiftwall.App.Localization">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T Anonymize.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Anonymize.Intro}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ContentControl Content="{Binding Config}" Focusable="False" />
                    <TextBlock Text="{l:T Anonymize.Options}" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="{l:T Anonymize.PublicIps}" IsChecked="True" IsEnabled="False" Margin="0,2" />
                    <CheckBox Content="{l:T Anonymize.Secrets}" IsChecked="True" IsEnabled="False" Margin="0,2" />
                    <CheckBox Content="{l:T Anonymize.PrivateIps}" IsChecked="{Binding PrivateIps}" Margin="0,2" />
                    <CheckBox Content="{l:T Anonymize.Hostnames}" IsChecked="{Binding Hostnames}" Margin="0,2" />
                    <CheckBox Content="{l:T Anonymize.Users}" IsChecked="{Binding Users}" Margin="0,2" />
                    <CheckBox Content="{l:T Anonymize.Emails}" IsChecked="{Binding Emails}" Margin="0,2" />
                    <CheckBox Content="{l:T Anonymize.Comments}" IsChecked="{Binding Comments}" Margin="0,2" />
                    <TextBlock Text="{Binding Stats}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />

                    <TextBlock Text="{l:T Anonymize.MapTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:T Anonymize.MapHelp}" Style="{StaticResource Muted}" FontSize="11" />
                    <TextBlock Text="{l:T Anonymize.Password}" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="Password" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="{l:T Anonymize.Password}" />
                    <TextBlock Text="{l:T Anonymize.PasswordConfirm}" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordConfirm" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="{l:T Anonymize.PasswordConfirm}" />
                    <TextBlock Text="{Binding PasswordHint}" Foreground="#C42B1C" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{l:T Anonymize.SaveMap}" Command="{Binding SaveMapCommand}" Margin="0,0,8,0" />
                        <Button Content="{l:T Anonymize.SaveOutput}" Command="{Binding SaveOutputCommand}" />
                    </StackPanel>
                    <TextBlock Text="{l:T Anonymize.SaveOrder}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />

                    <TextBlock Text="{l:T Anonymize.RestoreTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:T Anonymize.RestoreHelp}" Style="{StaticResource Muted}" FontSize="11" />
                    <ContentControl Content="{Binding RestoreSource}" Focusable="False" Margin="0,6,0,0" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="{l:T Anonymize.PickMap}" Command="{Binding BrowseMapCommand}" />
                        <TextBlock Text="{Binding MapPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    </DockPanel>
                    <TextBlock Text="{l:T Anonymize.Password}" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="RestorePassword" PasswordChanged="OnRestorePasswordChanged" AutomationProperties.Name="{l:T Anonymize.Password}" />
                    <Button Content="{l:T Anonymize.Restore}" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{l:T Anonymize.Preview}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Preview, Mode=OneWay}" Style="{StaticResource ScriptBox}" AutomationProperties.Name="{l:T Anonymize.Preview}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
