<UserControl x:Class="Shiftwall.App.Views.VpnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Shiftwall.App.Localization">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T Vpn.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Vpn.Intro}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:T Vpn.Local}" Style="{StaticResource FieldLabel}" />
                    <ContentControl Content="{Binding Local}" Focusable="False" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:T Vpn.Remote}" Style="{StaticResource FieldLabel}" />
                    <ContentControl Content="{Binding Remote}" Focusable="False" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,12,0,8" TextWrapping="Wrap" />
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      AutomationProperties.Name="{l:T Vpn.Tunnels}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="VDOM" Binding="{Binding Vdom}" Width="SizeToHeader" />
                    <DataGridTextColumn Header="{l:T Vpn.Col.Tunnel}" Binding="{Binding Tunnel}" Width="1*" MinWidth="80" />
                    <DataGridTextColumn Header="{l:T Vpn.Col.Phase}" Binding="{Binding Phase}" Width="SizeToHeader" />
                    <DataGridTextColumn Header="{l:T Vpn.Col.Name}" Binding="{Binding Name}" Width="1*" MinWidth="80" />
                    <DataGridTextColumn Header="{l:T Vpn.Col.Endpoints}" Binding="{Binding Endpoints}" Width="2*" MinWidth="140" />
                    <DataGridTextColumn Header="{l:T Vpn.Col.Proposal}" Binding="{Binding Proposal}" Width="2*" MinWidth="120" />
                    <DataGridTextColumn Header="DH" Binding="{Binding DhGroups}" Width="70" />
                    <DataGridTextColumn Header="{l:T Vpn.Col.Lifetime}" Binding="{Binding Lifetime}" Width="SizeToHeader" />
                    <DataGridTextColumn Header="" Binding="{Binding Extra}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Text="{l:T Vpn.Checks}" Style="{StaticResource SectionTitle}" />
            <DataGrid Grid.Row="2" ItemsSource="{Binding Checks}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      AutomationProperties.Name="{l:T Vpn.Checks}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="32">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Severity, Converter={StaticResource SeverityToGlyph}}"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T Vpn.Col.Tunnel}" Binding="{Binding Tunnels}" Width="1*" MinWidth="100" />
                    <DataGridTextColumn Header="{l:T Vpn.Col.Parameter}" Binding="{Binding Parameter}" Width="1.5*" MinWidth="120" />
                    <DataGridTextColumn Header="{l:T Vpn.Local}" Binding="{Binding Local}" Width="1.5*" MinWidth="100" />
                    <DataGridTextColumn Header="{l:T Vpn.Remote}" Binding="{Binding Remote}" Width="1.5*" MinWidth="100" />
                    <DataGridTextColumn Header="{l:T Vpn.Col.Result}" Binding="{Binding ResultText}" Width="Auto" MinWidth="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
