<UserControl x:Class="Shiftwall.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Shiftwall.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/logo-128.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Shiftwall" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="{l:T About.Version}" /> <Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T About.Privacy.Title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{l:T About.Privacy.Statement}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{l:T About.Privacy.Details}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T About.Database.Title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding DatabaseSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{l:T About.Database.Hint}" Style="{StaticResource Muted}" Margin="0,6,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:T About.Database.Import}" Command="{Binding ImportDatabaseCommand}" Margin="0,0,8,0" />
                        <Button Content="{l:T About.Database.Reset}" Command="{Binding ResetDatabaseCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T About.Disclaimer.Title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{l:T About.Disclaimer}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="{l:T About.Repository}" Command="{Binding OpenRepositoryCommand}" />
                <TextBlock Text="{l:T About.License}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
