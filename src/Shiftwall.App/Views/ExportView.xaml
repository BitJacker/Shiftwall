<UserControl x:Class="Shiftwall.App.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Shiftwall.App.Localization">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T Export.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Export.Intro}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
            <ContentControl Content="{Binding Config}" Focusable="False" />
            <DockPanel Margin="0,12,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{l:T Export.SaveXlsx}" Command="{Binding SaveXlsxCommand}" Margin="8,0,0,0" />
                    <Button Content="{l:T Export.SaveCsv}" Command="{Binding SaveCsvCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" DisplayMemberPath="Name" Width="220"
                          AutomationProperties.Name="{l:T Export.Sheet}" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Preview}" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" AutomationProperties.Name="{l:T Export.Preview}" />
    </DockPanel>
</UserControl>
