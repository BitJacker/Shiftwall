<UserControl x:Class="Shiftwall.App.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Shiftwall.App.Localization">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T Audit.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Audit.Intro}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding Config}" Focusable="False" />
                <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ScoreText}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <ProgressBar Value="{Binding Score, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,6" />
                        <TextBlock Text="{l:T Audit.ScoreHelp}" FontSize="11" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
            </Grid>
            <DockPanel Margin="0,12,0,8">
                <Button DockPanel.Dock="Right" Content="{l:T Audit.ExportCsv}" Command="{Binding ExportCsvCommand}" Margin="8,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="{l:T Audit.ShowPassed}" IsChecked="{Binding ShowPassed}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
            </DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{Binding ItemSeverity, Converter={StaticResource SeverityToGlyph}}"
                                                   Foreground="{Binding ItemSeverity, Converter={StaticResource SeverityToBrush}}" Margin="0,2,8,0" />
                                        <TextBlock DockPanel.Dock="Right" Foreground="Gray" FontSize="11" VerticalAlignment="Center">
                                            <Run Text="{Binding Id, Mode=OneWay}" /> · <Run Text="{Binding SeverityText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Occurrences}" Margin="24,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="24,6,0,0" TextWrapping="Wrap" Style="{StaticResource Muted}">
                                        <Run Text="{l:T Audit.Why}" FontWeight="SemiBold" /> <Run Text="{Binding Why, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="24,4,0,0" TextWrapping="Wrap">
                                        <Run Text="{l:T Audit.Fix}" FontWeight="SemiBold" /> <Run Text="{Binding Fix, Mode=OneWay}" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Sources}" Margin="24,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LinkButton}" Content="{Binding Title}" FontSize="11" Margin="0,1"
                                                        Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Url}" ToolTip="{Binding Url}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
