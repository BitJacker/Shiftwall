<UserControl x:Class="Shiftwall.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Shiftwall.App.Localization">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T Cleanup.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Cleanup.Intro}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:T Cleanup.Config}" Style="{StaticResource FieldLabel}" />
                    <ContentControl Content="{Binding Config}" Focusable="False" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:T Cleanup.Reference}" Style="{StaticResource FieldLabel}" />
                    <ContentControl Content="{Binding Reference}" Focusable="False" />
                    <TextBlock Text="{l:T Cleanup.ReferenceHelp}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
            <DockPanel Margin="0,12,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{l:T Cleanup.SelectAll}" Command="{Binding SelectAllCommand}" Margin="8,0,0,0" />
                    <Button Content="{l:T Cleanup.SelectNone}" Command="{Binding SelectNoneCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="{l:T Cleanup.Title}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36" />
                    <DataGridTextColumn Header="VDOM" Binding="{Binding Vdom}" IsReadOnly="True" Width="80" />
                    <DataGridTextColumn Header="{l:T Cleanup.Col.Table}" Binding="{Binding Table}" IsReadOnly="True" Width="190" />
                    <DataGridTextColumn Header="{l:T Cleanup.Col.Name}" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                    <DataGridCheckBoxColumn Header="{l:T Cleanup.Col.ViaGroup}" Binding="{Binding ViaGroup, Mode=OneWay}" IsReadOnly="True" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{l:T Tool.Copy}" Command="{Binding CopyCommand}" Margin="0,0,8,0" />
                    <Button Content="{l:T Tool.SaveScript}" Command="{Binding SaveCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:T Cleanup.ScriptHelp}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Text="{Binding Script, Mode=OneWay}" Style="{StaticResource ScriptBox}" AutomationProperties.Name="{l:T Tool.Script}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
