<UserControl x:Class="Shiftwall.App.Views.UpgradeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Shiftwall.App.Localization">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T Upgrade.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Upgrade.Intro}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
            <WrapPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{l:T Upgrade.Model}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Id" Width="200" AutomationProperties.Name="{l:T Upgrade.Model}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:T Upgrade.Current}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding CurrentVersions}" SelectedItem="{Binding CurrentVersion}" Width="140" AutomationProperties.Name="{l:T Upgrade.Current}" />
                </StackPanel>
            </WrapPanel>
            <Border Style="{StaticResource Card}" Margin="0,14,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding PathStatus}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{l:T Upgrade.OpenTool}" Command="{Binding OpenToolCommand}" />
                        <TextBlock Text="{Binding ToolUrl}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{l:T Upgrade.Newer}" Style="{StaticResource SectionTitle}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Newer}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AutomationProperties.Name="{l:T Upgrade.Newer}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="FortiOS" Binding="{Binding Version}" Width="90" />
                <DataGridTextColumn Header="Build" Binding="{Binding Build}" Width="80" />
                <DataGridTextColumn Header="{l:T Upgrade.Col.Date}" Binding="{Binding Date}" Width="110" />
                <DataGridCheckBoxColumn Header="{l:T Upgrade.Col.Supports}" Binding="{Binding SupportsModel, Mode=OneWay}" Width="150" />
                <DataGridTemplateColumn Header="{l:T Upgrade.Col.Source}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButton}" Content="{Binding SourceUrl}" FontSize="11"
                                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding SourceUrl}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
