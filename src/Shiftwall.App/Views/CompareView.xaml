<UserControl x:Class="Shiftwall.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Shiftwall.App.Localization">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T Compare.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Compare.Intro}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:T Compare.Left}" Style="{StaticResource FieldLabel}" />
                    <ContentControl Content="{Binding Left}" Focusable="False" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:T Compare.Right}" Style="{StaticResource FieldLabel}" />
                    <ContentControl Content="{Binding Right}" Focusable="False" />
                </StackPanel>
            </Grid>
            <DockPanel Margin="0,12,0,8">
                <Button DockPanel.Dock="Right" Content="{l:T Compare.ExportCsv}" Command="{Binding ExportCsvCommand}" Margin="8,0,0,0" />
                <TextBox DockPanel.Dock="Right" Width="220" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{l:T Compare.Filter}" ToolTip="{l:T Compare.Filter}" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
            </DockPanel>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" AutomationProperties.Name="{l:T Compare.Title}" VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:T Compare.Col.Change}" Binding="{Binding KindText}" Width="110" />
                <DataGridTextColumn Header="{l:T Compare.Col.Location}" Binding="{Binding Location}" Width="320" />
                <DataGridTextColumn Header="{l:T Compare.Col.Details}" Binding="{Binding Details}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
