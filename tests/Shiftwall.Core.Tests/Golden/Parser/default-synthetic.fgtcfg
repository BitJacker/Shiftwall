#config-version=FGT60F-7.6.8-FW-build3744-261022:opmode=0:vdom=0:user=admin
#conf_file_ver=5234567890123456
#buildno=3744
#global_vdom=1
config system global
    set hostname "FortiGate-60F"
end
config system interface
    edit "wan1"
        set vdom "root"
        set mode dhcp
        set type physical
    next
    edit "dmz"
        set vdom "root"
        set ip 10.10.10.1 255.255.255.0
        set type physical
    next
    edit "internal1"
        set vdom "root"
        set type physical
    next
    edit "internal2"
        set vdom "root"
        set type physical
    next
    edit "internal"
        set vdom "root"
        set ip 192.168.1.99 255.255.255.0
        set type hard-switch
    next
    edit "fortilink"
        set vdom "root"
        set type aggregate
    next
end
config system virtual-switch
    edit "internal"
        set physical-switch "sw0"
        config port
            edit "internal1"
            next
            edit "internal2"
            next
        end
    next
end
