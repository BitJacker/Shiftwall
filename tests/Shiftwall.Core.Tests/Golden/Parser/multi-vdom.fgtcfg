#config-version=FGT100F-7.6.8-FW-build3744-261022:opmode=0:vdom=1:user=admin
#conf_file_ver=2234567890123456
#buildno=3744
#global_vdom=1

config vdom
edit root
next
edit branch
next
end

config global
config system global
    set hostname "lab-mv-01"
    set private-data-encryption enable
end
config system interface
    edit "port1"
        set vdom "root"
        set ip 203.0.113.20 255.255.255.0
        set type physical
    next
    edit "port2"
        set vdom "branch"
        set ip 192.168.20.1 255.255.255.0
        set type physical
    next
end
end

config vdom
edit root
config system settings
    set opmode nat
end
config firewall policy
    edit 1
        set srcintf "port1"
        set dstintf "port1"
        set srcaddr "all"
        set dstaddr "all"
        set action accept
        set schedule "always"
        set service "ALL"
    next
end
next
edit branch
config firewall address
    edit "branch-lan"
        set subnet 192.168.20.0 255.255.255.0
    next
end
next
end
