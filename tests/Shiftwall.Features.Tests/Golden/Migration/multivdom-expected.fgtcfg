#config-version=FGTSYN-7.4.13-FW-build2933-261022:opmode=0:vdom=1:user=admin
#conf_file_ver=6234567890123499
#buildno=2933
#global_vdom=1
config vdom
    edit "root"
    next
    edit "branch"
    next
end
config global
config system global
    set hostname "mv-01"
    set vdom-mode multi-vdom
end
config system interface
    edit "port1"
        set vdom "root"
        set ip 203.0.113.20 255.255.255.0
        set allowaccess ping https
        set type physical
        set role wan
    next
    edit "port2"
        set vdom "branch"
        set ip 198.51.100.20 255.255.255.0
        set type physical
        set role wan
    next
    edit "port3"
        set vdom "root"
        set ip 192.168.1.1 255.255.255.0
        set type physical
    next
    edit "port4"
        set vdom "branch"
        set ip 192.168.2.1 255.255.255.0
        set type physical
    next
    edit "ha"
        set vdom "root"
        set type physical
    next
    edit "vl100"
        set vdom "branch"
        set ip 192.168.100.1 255.255.255.0
        set interface "port4"
        set vlanid 100
    next
end
config system ha
    set hbdev "ha" 50
end
end
config vdom
edit root
config firewall policy
    edit 1
        set name "root-out"
        set srcintf "port3"
        set dstintf "port1"
        set action accept
        set srcaddr "all"
        set dstaddr "all"
        set schedule "always"
        set service "ALL"
        set nat enable
        set comments "uses wan1 and internal1"
    next
end
config router static
    edit 1
        set gateway 203.0.113.1
        set device "port1"
    next
end
next
edit branch
config firewall policy
    edit 1
        set name "branch-out"
        set srcintf "port4" "vl100"
        set dstintf "port2"
        set action accept
        set srcaddr "all"
        set dstaddr "all"
        set schedule "always"
        set service "ALL"
        set nat enable
    next
end
config router static
    edit 1
        set gateway 198.51.100.1
        set device "port2"
    next
end
next
end
