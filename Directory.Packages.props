<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test-only packages (not shipped in Shiftwall.exe). Licenses verified on nuget.org, see THIRD-PARTY-NOTICES.md. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shipped in Shiftwall.exe. Apache-2.0, verified on nuget.org 2026-11-15. -->
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
  </ItemGroup>
</Project>
